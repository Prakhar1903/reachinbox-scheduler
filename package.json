{
  "name": "reachinbox-scheduler",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "pnpm --filter @reachinbox/backend dev",
    "dev:frontend": "pnpm --filter @reachinbox/frontend dev",
    "dev": "pnpm --filter @reachinbox/backend dev & pnpm --filter @reachinbox/frontend dev",
    "build:backend": "pnpm --filter @reachinbox/backend build",
    "build:frontend": "pnpm --filter @reachinbox/frontend build",
    "build": "pnpm --filter @reachinbox/backend build && pnpm --filter @reachinbox/frontend build",
    "start:backend": "pnpm --filter @reachinbox/backend start",
    "test:backend": "pnpm --filter @reachinbox/backend test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
